{
  "name": "bharatarchive",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @bharatarchive/api --filter @bharatarchive/web dev",
    "build": "pnpm db:generate && pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @bharatarchive/api test",
    "db:generate": "pnpm --filter @bharatarchive/database generate",
    "db:migrate": "pnpm --filter @bharatarchive/database migrate",
    "db:seed": "pnpm --filter @bharatarchive/database seed",
    "postinstall": "pnpm db:generate"
  }
}
